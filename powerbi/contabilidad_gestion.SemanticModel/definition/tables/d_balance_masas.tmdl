	column importe
		dataType: decimal
		formatString: #,0.00 €
		lineageTag: b1a960ae-22e9-4a50-9291-74a85a3572d4
		sourceColumn: importe

	partition d_balance_masas = m
		mode: import
		source = Table.TransformColumnTypes(LeerCsv("d_balance_masas.csv"), {{"ano", Int64.Type}, {"completo", type logical}, {"masa", type text}, {"importe", Currency.Type}}, "en-US")

