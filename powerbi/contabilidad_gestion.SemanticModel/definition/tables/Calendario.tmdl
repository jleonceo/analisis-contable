/// Tabla de fechas hecha en DAX: un día por fila, del 1 de enero del ejercicio al último mes de la tabla de hechos.
table Calendario
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: [Fecha]

	column Año
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Año]

	column MesNumero
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: [MesNumero]

	column Mes
		dataType: string
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: MesNumero

	partition Calendario = calculated
		mode: import
		source = ```
				VAR Primero = MIN ( h_real_presupuesto_mes[fecha] )
				VAR Ultimo = EOMONTH ( MAX ( h_real_presupuesto_mes[fecha] ), 0 )
				RETURN
				    SELECTCOLUMNS (
				        CALENDAR ( DATE ( YEAR ( Primero ), 1, 1 ), Ultimo ),
				        "Fecha", [Date],
				        "Año", YEAR ( [Date] ),
				        "MesNumero", MONTH ( [Date] ),
				        "Mes", FORMAT ( [Date], "mmm", "es-ES" )
				    )
				```

